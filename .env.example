# 이 파일을 복사해서 .env 를 만들고 값을 채워요. (.env 는 GitHub에 올라가지 않아요)
#   cp .env.example .env

# Google AI Studio 에서 발급 (각자 본인 키)
GEMINI_API_KEY=
# 사용할 모델 이름. AI Studio 에서 무료로 쓸 수 있는 Flash 계열 모델명을 넣어요.
GEMINI_MODEL=gemini-3.5-flash

# console.groq.com 에서 발급 (STT용)
GROQ_API_KEY=

# edge-tts 목소리 (ko-KR-SunHiNeural / ko-KR-InJoonNeural)
TTS_VOICE=ko-KR-SunHiNeural

# 웹캠 번호 (기본 0, 외장 웹캠이면 1)
CAMERA_INDEX=0
