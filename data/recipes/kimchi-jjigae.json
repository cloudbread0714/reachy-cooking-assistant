{
  "name": "김치찌개",
  "ingredients": ["김치", "돼지고기", "두부", "대파", "양파"],
  "optional": ["고춧가루", "참치"],
  "tags": ["매운", "찌개", "한식"],
  "time_min": 25,
  "steps": [
    "냄비에 돼지고기를 넣고 중불에서 볶아줘.",
    "김치를 넣고 2~3분 더 볶아줘.",
    "물 두 컵을 붓고 끓여줘.",
    "끓으면 두부와 양파를 넣고 5분 더 끓여줘.",
    "대파를 넣고 1분 뒤에 불을 꺼줘."
  ]
}
